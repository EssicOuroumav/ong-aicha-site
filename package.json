{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "test": "vitest run",
    "typecheck": "next typegen && tsc --noEmit",
    "check:launch": "node scripts/check-launch.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:deploy:test": "prisma migrate deploy",
    "db:deploy:prod": "PRISMA_TARGET=production prisma migrate deploy",
    "db:seed:test": "prisma db seed",
    "db:backup": "tsx scripts/backup.ts",
    "db:backup:prod": "PRISMA_TARGET=production tsx scripts/backup.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "7.10",
    "@sentry/nextjs": "^11.6.0",
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.7",
    "lucide-react": "^1.55.0",
    "next": "16.4.0",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
